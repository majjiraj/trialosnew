# Auth
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://api.trialo.io
JWT_SECRET=

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trialo
POSTGRES_USER=trialo
POSTGRES_PASSWORD=

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_BRONZE=trialo-bronze
S3_BUCKET_SILVER=trialo-silver
S3_BUCKET_GOLD=trialo-gold
S3_BUCKET_ARTIFACTS=trialo-artifacts
S3_ACCESS_KEY=
S3_SECRET_KEY=

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embedding
EMBEDDING_PROVIDER=openai        # openai | ollama | huggingface
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536               # 768 for nomic-embed-text, 1024 for BAAI/bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# Kafka
KAFKA_BROKERS=localhost:9092

# Vector Store
PGVECTOR_CONNECTION_STRING=postgresql://trialo:password@localhost:5432/trialo_vectors

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SLACK_BOT_TOKEN=

# Services (internal URLs used by backend services)
AUTH_SERVICE_URL=http://localhost:8001
AUDIT_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_URL=http://localhost:8003
AGENT_RUNTIME_URL=http://localhost:8004
MARKETPLACE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8006
DATA_PLATFORM_URL=http://localhost:8007
GRAPHQL_API_URL=http://localhost:4000

# Frontend (public env vars — must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql
NEXT_PUBLIC_NOTIFICATION_WS_URL=ws://localhost:8006/ws
NEXT_PUBLIC_AUDIT_URL=http://localhost:8002
NEXT_PUBLIC_AGENT_RUNTIME_URL=http://localhost:8004

# Feature Flags
ENABLE_PHI_LOGGING=false
OCR_PROVIDER=tesseract  # tesseract | textract
ENABLE_AGENT_MARKETPLACE=true
ENABLE_UI_AGENT_BUILDER=true
