<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_ae-intake"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="adverse-event-intake" name="Adverse Event Intake" isExecutable="true">

    <bpmn:startEvent id="ae_start" name="AE Reported">
      <bpmn:outgoing>ae_flow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="ae_capture" name="Capture Adverse Event">
      <bpmn:extensionElements>
        <zeebe:formDefinition formKey="form-adverse-event-capture"/>
        <zeebe:taskHeaders>
          <zeebe:header key="assignee_role" value="site_crc|site_pi"/>
          <zeebe:header key="sla_hours" value="24"/>
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:output source="=ae_term" target="ae_term"/>
          <zeebe:output source="=severity" target="severity"/>
          <zeebe:output source="=is_serious" target="is_serious"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>ae_flow1</bpmn:incoming>
      <bpmn:outgoing>ae_flow2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ae_triage" name="AI Triage and Route">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="trialo:agent-run" retries="2"/>
        <zeebe:taskHeaders>
          <zeebe:header key="agent_slug" value="ae-triage"/>
          <zeebe:header key="trigger_mode" value="always"/>
          <zeebe:header key="output_mapping" value="{&quot;requires_sae_workflow&quot;:&quot;requires_sae&quot;}"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>ae_flow2</bpmn:incoming>
      <bpmn:outgoing>ae_flow3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ae_gateway" name="Requires SAE?" default="ae_flow_non_serious">
      <bpmn:incoming>ae_flow3</bpmn:incoming>
      <bpmn:outgoing>ae_flow_serious</bpmn:outgoing>
      <bpmn:outgoing>ae_flow_non_serious</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ae_escalate_sae" name="Escalate to SAE Review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="trialo:send-notification" retries="3"/>
        <zeebe:taskHeaders>
          <zeebe:header key="notification_type" value="sae_escalation"/>
          <zeebe:header key="severity" value="high"/>
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;SAE Escalation Required: &quot;+ae_term" target="title"/>
          <zeebe:input source="=org_id" target="org_id"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>ae_flow_serious</bpmn:incoming>
      <bpmn:outgoing>ae_flow_end_serious</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="ae_non_serious_review" name="Non-Serious AE Review">
      <bpmn:extensionElements>
        <zeebe:taskHeaders>
          <zeebe:header key="assignee_role" value="cro_data_manager"/>
          <zeebe:header key="sla_hours" value="72"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>ae_flow_non_serious</bpmn:incoming>
      <bpmn:outgoing>ae_flow_end_standard</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="ae_end_serious" name="Escalated to SAE">
      <bpmn:incoming>ae_flow_end_serious</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="ae_end_standard" name="AE Processed">
      <bpmn:incoming>ae_flow_end_standard</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="ae_flow1" sourceRef="ae_start" targetRef="ae_capture"/>
    <bpmn:sequenceFlow id="ae_flow2" sourceRef="ae_capture" targetRef="ae_triage"/>
    <bpmn:sequenceFlow id="ae_flow3" sourceRef="ae_triage" targetRef="ae_gateway"/>
    <bpmn:sequenceFlow id="ae_flow_serious" name="Is SAE" sourceRef="ae_gateway" targetRef="ae_escalate_sae">
      <bpmn:conditionExpression>=requires_sae_workflow = true or is_serious = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ae_flow_non_serious" name="Not Serious" sourceRef="ae_gateway" targetRef="ae_non_serious_review"/>
    <bpmn:sequenceFlow id="ae_flow_end_serious" sourceRef="ae_escalate_sae" targetRef="ae_end_serious"/>
    <bpmn:sequenceFlow id="ae_flow_end_standard" sourceRef="ae_non_serious_review" targetRef="ae_end_standard"/>

  </bpmn:process>
</bpmn:definitions>
