# ============================================================
# TrialOS — Dev Environment Configuration
# Copy this to .env and fill in your own API keys
# All infrastructure passwords below are hard-coded in docker-compose.dev.yml
# ============================================================

# ── Infrastructure passwords (match docker-compose.dev.yml) ──────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trialo
POSTGRES_USER=trialo
POSTGRES_PASSWORD=trialo_dev
DATABASE_URL=postgresql://trialo:trialo_dev@localhost:5432/trialo

# Object Storage — MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_BRONZE=trialo-bronze
S3_BUCKET_SILVER=trialo-silver
S3_BUCKET_GOLD=trialo-gold
S3_BUCKET_ARTIFACTS=trialo-artifacts
S3_ACCESS_KEY=trialo
S3_SECRET_KEY=trialo_dev_secret

# MongoDB
MONGO_URL=mongodb://trialo:trialopass@localhost:27017/trialo?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Neo4j
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=trialo_dev

# Auth — use a strong random value in prod
JWT_SECRET=dev-jwt-secret-change-in-production
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://api.trialo.io

# ── LLM Providers (add your own keys) ────────────────────────────────────────
# Choose one: ollama (free, local) | openai | anthropic | bedrock

# Ollama — runs locally, no key needed
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma:latest

# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic (optional — required for protocol-usdm-v3 service)
ANTHROPIC_API_KEY=

# AWS Bedrock (optional)
# LLM_PROVIDER=bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ── Internal Service URLs ─────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8001
AUDIT_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_URL=http://localhost:8003
AGENT_RUNTIME_URL=http://localhost:8004
MARKETPLACE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8006
DATA_PLATFORM_URL=http://localhost:8007
GRAPHQL_API_URL=http://localhost:4000
APP_COMPOSER_URL=http://localhost:8009
FORM_ENGINE_URL=http://localhost:8010
WORKFLOW_BRIDGE_URL=http://localhost:8011
QUALITY_SERVICE_URL=http://localhost:8016

# ── Frontend Public URLs ──────────────────────────────────────────────────────
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql
NEXT_PUBLIC_NOTIFICATION_WS_URL=ws://localhost:8006/ws
NEXT_PUBLIC_AUDIT_URL=http://localhost:8002
NEXT_PUBLIC_AUTH_URL=http://localhost:8001
NEXT_PUBLIC_INGESTION_URL=http://localhost:8003
NEXT_PUBLIC_CONTEXT_GRAPH_URL=http://localhost:8008
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:8005
NEXT_PUBLIC_APP_COMPOSER_URL=http://localhost:8009
NEXT_PUBLIC_WORKFLOW_BRIDGE_URL=http://localhost:8011
NEXT_PUBLIC_FORM_ENGINE_URL=http://localhost:8010
NEXT_PUBLIC_QUALITY_SERVICE_URL=http://localhost:8016

# ── ACP (Application Composition Platform) ───────────────────────────────────
FIELD_ENCRYPTION_KEY=c2a4e8f16b3d0742a9c5e1f8b27d4e6a3f0c8b2d5e9f1a4c7b0d3e6f8a2c5e8
ZEEBE_ADDRESS=localhost:26500

# ── Protocol USDM v3 ─────────────────────────────────────────────────────────
PROTOCOL_USDM_V3_API_KEY=trialo-internal
USE_PROTOCOL_USDM_V3=true

# ── Observability (Langfuse) ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-trialo
LANGFUSE_SECRET_KEY=sk-lf-trialo
LANGFUSE_HOST=http://langfuse:3000

# ── Notifications (optional) ──────────────────────────────────────────────────
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SLACK_BOT_TOKEN=

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_PHI_LOGGING=false
OCR_PROVIDER=tesseract
ENABLE_AGENT_MARKETPLACE=true
ENABLE_UI_AGENT_BUILDER=true
PGVECTOR_CONNECTION_STRING=postgresql://trialo:trialo_dev@localhost:5432/trialo
